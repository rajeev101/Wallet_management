{
  "expo": {
    "name": "Campus Wallet",
    "slug": "campus-wallet",
    "version": "1.0.3",
    "icon": "./assets/logo.png",
    "scheme": "campuswallet",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.mapawallet.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.mapawallet.mobile",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#304253"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "transactions"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Campus Wallet to scan vendor payment QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Campus Wallet to choose your profile photo.",
          "cameraPermission": "Allow Campus Wallet to scan vendor payment QR codes.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#304253"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Campus Wallet to access your current location while you use the app.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ]
  }
}
